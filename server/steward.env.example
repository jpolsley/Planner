# Copy this file to steward.env and fill in STEWARD_KEY.
# A long passphrase. Enter the same one in Steward when you connect.
STEWARD_KEY=
# The Ollama model to use. Add fallbacks after a comma, e.g. qwen3:32b,qwen3:14b
MODEL=qwen3:32b
# Where your documents (docs/) and synced planner (data/) live.
STEWARD_HOME=~/Steward
PORT=8787
