# Copy this file to steward.env and fill in STEWARD_KEY.
# A long passphrase. Enter the same one in Steward when you connect.
STEWARD_KEY=
# The Ollama model to use. Add fallbacks after a comma, e.g. qwen3:32b,qwen3:14b
MODEL=qwen3:32b
# Where your documents (docs/) and synced planner (data/) live.
STEWARD_HOME=~/Steward
PORT=8787
# Room for Steward's briefing (tokens). Lower it if the computer runs out of memory.
# NUM_CTX=12288
# How long Ollama keeps the model loaded between messages.
# KEEP_ALIVE=24h
# Work calendar (read-only): the view-only OneDrive link to diana-calendar.json that Power Automate updates hourly.
# It's a secret: keep it only here. If it ever leaks, remove the share link in OneDrive and make a new one.
# DIANA_WORK_CALENDAR_FEED_URL=
# Private/confidential work events show with their real titles. Set to 1 to show them only as "Private appointment".
# DIANA_WORK_CALENDAR_HIDE_PRIVATE=0
# Work email (read-only): the view-only OneDrive link to diana-email.json (Inbox + Sent previews) from Power Automate.
# Also a secret: keep it only here.
# DIANA_WORK_EMAIL_FEED_URL=
# Domains that count as "internal" (comma-separated; subdomains included).
# DIANA_WORK_EMAIL_DOMAINS=salvationarmy.org
